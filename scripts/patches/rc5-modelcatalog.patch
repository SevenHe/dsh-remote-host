+describe('ModelCatalogDirectory per-Session ownership', () => {
+  const sessionA = 'session-a' as never
+  const sessionB = 'session-b' as never
+
+  it('keeps the Session-less request shape when no Session is named', async () => {
+    const models = vi.fn().mockResolvedValue({ ok: true, value: catalog('host') })
+    const subject = directory(models)
+    await subject.load()
+    expect(models).toHaveBeenCalledWith()
+  })
+
+  it('sends the owning Session id so a multi-Host carrier can route the read', async () => {
+    const models = vi.fn().mockResolvedValue({ ok: true, value: catalog('remote-host-model') })
+    const subject = directory(models)
+    await subject.load(sessionA)
+    expect(models).toHaveBeenCalledWith(sessionA)
+    expect(subject.storeFor(sessionA).getSnapshot()).toMatchObject({ status: 'ready' })
+  })
+
+  it('loads each Session once and reuses it when switching back', async () => {
+    const models = vi.fn()
+      .mockResolvedValueOnce({ ok: true, value: catalog('local-model') })
+      .mockResolvedValueOnce({ ok: true, value: catalog('remote-model') })
+    const subject = directory(models)
+    await subject.load(sessionA)
+    await subject.load(sessionB)
+    expect(models).toHaveBeenCalledTimes(2)
+    expect(subject.storeFor(sessionA).getSnapshot().value).toEqual(catalog('local-model'))
+    expect(subject.storeFor(sessionB).getSnapshot().value).toEqual(catalog('remote-model'))
+    await subject.load(sessionA)
+    expect(models).toHaveBeenCalledTimes(2)
+  })
+
+  it('keeps the Host-wide catalog separate from a Session catalog', async () => {
+    const models = vi.fn()
+      .mockResolvedValueOnce({ ok: true, value: catalog('warm-up') })
+      .mockResolvedValueOnce({ ok: true, value: catalog('session-host') })
+    const subject = directory(models)
+    await subject.load()
+    await subject.load(sessionA)
+    expect(models).toHaveBeenNthCalledWith(1)
+    expect(models).toHaveBeenNthCalledWith(2, sessionA)
+    expect(subject.store.getSnapshot().value).toEqual(catalog('warm-up'))
+    expect(subject.storeFor(sessionA).getSnapshot().value).toEqual(catalog('session-host'))
+  })
+
+  it('invalidates every owner, not only the Host-wide one', async () => {
+    const models = vi.fn().mockResolvedValue({ ok: true, value: catalog('v1') })
+    const subject = directory(models)
+    await subject.load()
+    await subject.load(sessionA)
+    expect(models).toHaveBeenCalledTimes(2)
+    subject.resetGeneration()
+    await subject.load()
+    await subject.load(sessionA)
+    expect(models).toHaveBeenCalledTimes(4)
+  })
+
+  it('degrades an owner to the Session-less read when the Host predates the argument', async () => {
+    const models = vi.fn()
+      .mockResolvedValueOnce({
+        ok: false,
+        error: new RemoteError('gateway/arguments-invalid', 'typert gateway: session/modelCatalog: args fields do not match the descriptor: unexpected "sessionId"', { endpoint: 'session/modelCatalog' }),
+      })
+      .mockResolvedValueOnce({ ok: true, value: catalog('older-host') })
+    const subject = directory(models)
+    await expect(subject.load(sessionA)).resolves.toEqual(catalog('older-host'))
+    expect(models).toHaveBeenNthCalledWith(1, sessionA)
+    expect(models).toHaveBeenNthCalledWith(2)
+    expect(subject.storeFor(sessionA).getSnapshot()).toMatchObject({ status: 'ready', error: null })
+  })
+
+  it('remembers the degraded owner, so later reads stay Session-less', async () => {
+    const models = vi.fn()
+      .mockResolvedValueOnce({
+        ok: false,
+        error: new RemoteError('gateway/arguments-invalid', 'unexpected "sessionId"', { endpoint: 'session/modelCatalog' }),
+      })
+      .mockResolvedValue({ ok: true, value: catalog('older-host') })
+    const subject = directory(models)
+    await subject.load(sessionA)
+    subject.refresh()
+    await vi.waitFor(() => { expect(models).toHaveBeenCalledTimes(3) })
+    expect(models).toHaveBeenNthCalledWith(3)
+    expect(subject.storeFor(sessionA).getSnapshot()).toMatchObject({ status: 'ready' })
+  })
+
+  it('does not degrade an owner whose Host accepts the argument', async () => {
+    const models = vi.fn().mockResolvedValue({ ok: true, value: catalog('modern-host') })
+    const subject = directory(models)
+    await subject.load(sessionA)
+    await subject.load(sessionA)
+    expect(models).toHaveBeenCalledTimes(1)
+    expect(models).toHaveBeenNthCalledWith(1, sessionA)
+  })
+})
