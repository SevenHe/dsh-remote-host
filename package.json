{
  "name": "dsh-remote-host",
  "version": "1.14.4",
  "description": "Mount a remote DeepSeek Harness host into this app's native UI — its sessions, workspaces, super agent, tools and environment, driven from here.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "scripts"
  ],
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "remote",
    "ssh",
    "collaboration"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^0.2.2-rc.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "build:shim": "node scripts/build-shim.mjs",
    "test": "node --test test/*.test.mjs",
    "parity": "node scripts/parity-snapshot.mjs",
    "check": "node scripts/build-shim.mjs --check && node --check lib/index.js && node --check lib/client.js && node scripts/verify-manifest.mjs && node scripts/verify-index.mjs && node scripts/verify-sensitive.mjs && npm test",
    "ensure-profile": "node scripts/ensure-profile.mjs",
    "install-selfheal": "node scripts/install-selfheal.mjs"
  }
}
